if (!require("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

BiocManager::install("Maaslin2", force = TRUE)

library(Maaslin2) 

gutasvtable.m <- read.csv('EFajei2026LWFASV_DFinal_Classified.csv', sep=',', header=TRUE, row.names=1, check.names=F)
gutsampleinfo <- read.csv('EFajei2026LWFMetadata_DFinal.csv', sep=',', header=TRUE, row.names=1, check.names=F)
                         
                         
gutsampleinfo$Treatment <- factor(gutsampleinfo$Treatment, ordered = FALSE) 

fit_data = Maaslin2(input_data = gutasvtables,  
                    
                    input_metadata  = gutsampleinfo,  
                    
                    min_prevalence = 0.1,		       # Change to 0.1 to have in 10% of samples 
                    
                    normalization     = "CLR",                 # Can also use TSS or others 
                    
                    output                = "Maaslin2_output",  
                    
                    random_effects = c("Tank"),                   # Change to tank or pen if needed 
                    
